#include <stdio.h>
int main(void)
{
    double a,b;
    double area,perimeter;
    
    printf("Введите длину и ширину прямоугольника:\n");
    scanf("%lf%lf", &a, &b);
    
    if (a<0)
    a = a *-1;
    if (b<0)
    b = b *-1;
    
    area = a*b;
    perimeter = 2.0*(a+b);
    
    printf("=================================================================\n");
    printf("ПАРАМЕТР ПРЯМОУГОЛЬНИКА\n");
    printf("--------------------------------------------------------\n");
    printf("Длина: %.2f\n", a);
    printf("Ширина: %.2f\n", b);
    printf("Площадь: %.2f\n", area);
    printf("Периметр: %.2f\n", perimeter);
    printf("==================================================================\n");
    printf("Расчет завершен успешно\n");
    
    return 0;
  }
